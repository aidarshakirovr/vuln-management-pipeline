# Copy to .env and replace every change-me value.
# .env is gitignored. Do not commit real passwords, API tokens, or secret keys.
# Generate values with: openssl rand -hex 24
# DefectDojo's credential key is used as a raw string. Use 32 hex characters
# (openssl rand -hex 16) so it is 128 bits of random data.

# --- docker compose / DefectDojo -------------------------------------------
DD_PORT=8080
DD_TLS_PORT=8443
DD_ALLOWED_HOSTS=localhost,127.0.0.1

DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=change-me
DD_DATABASE_HOST=postgres
DD_DATABASE_PORT=5432

DD_SECRET_KEY=change-me
DD_CREDENTIAL_AES_256_KEY=change-me

DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@localhost
DD_ADMIN_PASSWORD=change-me
DD_INITIALIZE=true

# Official images are pinned in docker-compose.yml (tag 3.5.300).
# docker.io avoids ambiguity; registry.defectdojo.com is DefectDojo's mirror.
DD_IMAGE_REGISTRY=docker.io

# --- vmp upload (not read by compose) --------------------------------------
DD_URL=http://localhost:8080
DD_API_TOKEN=change-me
DD_PRODUCT_NAME=lab-vuln-app
DD_ENGAGEMENT_NAME=local-assessment
DD_PRODUCT_TYPE_NAME=Research and Development
